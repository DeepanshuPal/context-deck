{
  "manifest_version": 3,
  "name": "Context Deck",
  "version": "0.7.0",
  "description": "Click any word in YouTube or Netflix subtitles for an instant offline definition, and save it to Context Deck with its sentence and moment.",
  "key": "",
  "permissions": ["contextMenus", "storage", "unlimitedStorage", "downloads"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://www.netflix.com/*"], "js": ["content.js"], "run_at": "document_idle"}],
  "action": {"default_title": "Context Deck", "default_popup": "popup.html"}
}
